# Скопируй в .env и заполни ключи. Все переменные читаются только на сервере
# (runtimeConfig в nuxt.config.ts) и не попадают в клиентский бандл.

NUXT_FINANCE_BASE_URL=https://cpa-server-vtel.onrender.com/api
NUXT_FINANCE_API_KEY=
NUXT_FINANCE_TIMEOUT_MS=60000

NUXT_EXCHANGE_RATES_BASE_URL=https://api.currencyfreaks.com/v2.0
NUXT_EXCHANGE_RATES_API_KEY=
NUXT_EXCHANGE_RATES_TIMEOUT_MS=10000

NUXT_TARGET_CURRENCY=USD
